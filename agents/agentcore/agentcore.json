{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "agents",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "agents",
    "Project": "aws-operation-agent",
    "Environment": "default"
  },
  "runtimes": [
    {
      "name": "AWS_MCP_Agent",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/AWS_MCP_Agent/",
      "runtimeVersion": "PYTHON_3_13",
      "networkMode": "PUBLIC",
      "protocol": "AGUI",
      "envVars": [
        {
          "name": "ROLE_CONFIG_TABLE_NAME",
          "value": "RoleConfig-<SANDBOX_APPSYNC_API_ID>-NONE"
        },
        {
          "name": "ROLE_CONFIG_CACHE_TTL_SECONDS",
          "value": "30"
        }
      ],
      "requestHeaderAllowlist": [
        "X-Role-Names",
        "X-Amzn-Bedrock-AgentCore-Runtime-Custom-UserId"
      ]
    },
    {
      "name": "AWS_MCP_Agent_Prod",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/AWS_MCP_Agent/",
      "runtimeVersion": "PYTHON_3_13",
      "networkMode": "PUBLIC",
      "protocol": "AGUI",
      "envVars": [
        {
          "name": "ROLE_CONFIG_TABLE_NAME",
          "value": "RoleConfig-<PROD_APPSYNC_API_ID>-NONE"
        },
        {
          "name": "ROLE_CONFIG_CACHE_TTL_SECONDS",
          "value": "30"
        }
      ],
      "requestHeaderAllowlist": [
        "X-Role-Names",
        "X-Amzn-Bedrock-AgentCore-Runtime-Custom-UserId"
      ]
    }
  ],
  "memories": [
    {
      "name": "AWS_MCP_AgentMemory",
      "eventExpiryDuration": 365,
      "strategies": [
        { "type": "SEMANTIC" }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "AWS-MCP-Gateway",
      "description": "AWS MCP Gateway for tool access via IAM",
      "targets": []
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
