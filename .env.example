# ===========================================
# 環境変数テンプレート
# このファイルを .env.local にコピーして使用してください
# 実際の値はコミットしないでください
# ===========================================

# AWS リージョン（Amplify sandbox 用）
# AWS_REGION=us-west-2

# AgentCore Runtime ARN（エージェント機能を使う場合）
# Amplify Hosting ではコンソールの環境変数で設定してください
# NEXT_PUBLIC_AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:123456789012:runtime/sample_agent-xxxxxxxxxx

# copilotkitStreamingRelay Lambda の関数 URL（CopilotProvider.tsx の runtimeUrl）
# `npx ampx sandbox` 実行後、amplify_outputs.json の custom.copilotkitRelayUrl
# の値をここにコピーしてください。本番 Amplify Hosting ではコンソールの環境変数で
# 設定してください。
# NEXT_PUBLIC_COPILOTKIT_RELAY_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.us-west-2.on.aws/

# Role_Config_Table（Amplify Gen 2 Data_Model `RoleConfig`、DynamoDB）のテーブル名
# サーバーサイドのみ（NEXT_PUBLIC_ プレフィックスなし）。GET /api/roles がこの値を
# 使って DynamoDB を Scan し、roleArn を除いた一覧を認証済みユーザーに返します。
# agents/agentcore/agentcore.json の ROLE_CONFIG_TABLE_NAME と同じテーブルを指定してください。
# Role_Entry 自体は RoleConfigManager（ADMINS 専用メンテナンス画面）から登録します。
# ROLE_CONFIG_TABLE_NAME=RoleConfig-xxxxxxxxxxxxxxxxxxxxxxxxxx-NONE

# ---------------------------------------------------------------------------
# エージェント用環境変数（agents/ 内で使用）
# ---------------------------------------------------------------------------

# AgentCore Gateway MCP エンドポイント URL（必須）
# エージェント起動時にこの Gateway に接続し、ツールを取得します
# GATEWAY_URL=https://bedrock-agentcore.us-west-2.amazonaws.com/gateways/your-gateway-id/mcp

# Gateway 認証トークン（ローカル開発用）
# 本番では AgentCore Runtime が自動認証するため不要
# GATEWAY_AUTH_TOKEN=