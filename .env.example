# ===========================================
# 環境変数テンプレート
# このファイルを .env.local にコピーして使用してください
# 実際の値はコミットしないでください
# ===========================================
#
# エージェント機能を使わない場合、設定は不要です。
#
# AgentCore Runtime / Memory の ARN や ID は、Amplify のバックエンドスタックの一部として
# 作られ CDK が中継 Lambda に直接配線するため、環境変数として設定する必要はありません。
# 手動設定が必要なのはこのファイルにある 3 つだけです。

# AWS リージョン（Amplify sandbox 用）
# AWS_REGION=us-west-2

# ---------------------------------------------------------------------------
# エージェント機能を使う場合
# ---------------------------------------------------------------------------

# エージェント機能（AgentCore Runtime / Memory）を Amplify バックエンドに含めるか。
# true のときのみ AgentCore のリソースが作られます。未設定なら Web アプリのみです。
#
# 注意: .env.local に書いても `npx ampx sandbox` に渡るかはシェルの設定に依存するため、
# 確実に効かせるにはコマンドの前に付けてください:
#   AGENT_ENABLED=true npx ampx sandbox
#
# 有効にする前に、配布用パッケージのビルドが必要です:
#   ./scripts/build-agent-package.sh
#
# 本番 Amplify Hosting では、コンソールの環境変数として設定します。
# AGENT_ENABLED=true

# copilotkitStreamingRelay Lambda の関数 URL（CopilotProvider.tsx の runtimeUrl）
# デプロイ後、amplify_outputs.json の custom.copilotkitRelayUrl の値をコピーしてください。
#   cat amplify_outputs.json | jq -r .custom.copilotkitRelayUrl
# NEXT_PUBLIC_COPILOTKIT_RELAY_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.us-west-2.on.aws/

# Role_Config_Table（Amplify Gen 2 Data_Model `RoleConfig`、DynamoDB）のテーブル名
# サーバーサイドのみ（NEXT_PUBLIC_ プレフィックスなし）。GET /api/roles がこの値を
# 使って DynamoDB を Scan し、roleArn を除いた一覧を認証済みユーザーに返します。
# デプロイ後、amplify_outputs.json から取得できます。
#   cat amplify_outputs.json | jq -r .custom.roleConfigTableName
# エージェント（Runtime）側の同名の環境変数は CDK が自動設定するため、両者がずれることは
# ありません。Role_Entry 自体は ADMINS 専用のメンテナンス画面から登録します。
# ROLE_CONFIG_TABLE_NAME=RoleConfig-xxxxxxxxxxxxxxxxxxxxxxxxxx-NONE

# ---------------------------------------------------------------------------
# エージェント単体をローカルで動かす場合のみ（uvicorn での起動時）
# ---------------------------------------------------------------------------
#
# デプロイ時はこれらを CDK が Runtime の環境変数として設定するため、設定不要です。

# AWS MCP Server のエンドポイントとリージョン（未設定時は us-east-1 の既定値）
# AWS_MCP_ENDPOINT=https://aws-mcp.us-east-1.api.aws/mcp
# AWS_MCP_REGION=us-east-1

# Role_Config のキャッシュ TTL（秒、既定 30）
# ROLE_CONFIG_CACHE_TTL_SECONDS=30

# OpenTelemetry の警告を抑制してローカル起動する
# LOCAL_DEV=1
