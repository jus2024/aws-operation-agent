# ===========================================
# 環境変数テンプレート
# このファイルを .env.local にコピーして使用してください
# 実際の値はコミットしないでください
# ===========================================

# AWS リージョン（Amplify sandbox 用）
# AWS_REGION=us-west-2

# AgentCore Runtime ARN（エージェント機能を使う場合）
# copilotkitStreamingRelay の Lambda 環境変数と IAM ポリシーの Resource の両方に、
# CDK synth 時（`npx ampx sandbox` / `pipeline-deploy`）に反映されます。
# `agentcore status` で確認し、ローカル開発は AWS_MCP_Agent の ARN を指定してください
# （本番 Amplify Hosting は AWS_MCP_Agent_Prod の ARN をコンソールの環境変数で設定）。
# NEXT_PUBLIC_ プレフィックスは付けません（旧 NEXT_PUBLIC_AGENTCORE_RUNTIME_ARN は廃止）。
# AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:123456789012:runtime/AWS_MCP_Agent-xxxxxxxxxx

# AgentCore Memory ID（会話履歴の読み出しに使用）
# `agentcore status` の Memory リソースに表示される ID。AGENTCORE_RUNTIME_ARN と同じく
# CDK synth 時に読まれ、bedrock-agentcore:ListEvents の IAM ポリシーの Resource を絞り込みます。
# 未設定の場合はポリシー自体が付与されず、過去セッションの履歴復元が失敗します。
# AGENTCORE_MEMORY_ID=agents_AWS_MCP_AgentMemory-xxxxxxxxxx

# copilotkitStreamingRelay Lambda の関数 URL（CopilotProvider.tsx の runtimeUrl）
# `npx ampx sandbox` 実行後、amplify_outputs.json の custom.copilotkitRelayUrl
# の値をここにコピーしてください。本番 Amplify Hosting ではコンソールの環境変数で
# 設定してください。
# NEXT_PUBLIC_COPILOTKIT_RELAY_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.us-west-2.on.aws/

# Role_Config_Table（Amplify Gen 2 Data_Model `RoleConfig`、DynamoDB）のテーブル名
# サーバーサイドのみ（NEXT_PUBLIC_ プレフィックスなし）。GET /api/roles がこの値を
# 使って DynamoDB を Scan し、roleArn を除いた一覧を認証済みユーザーに返します。
# agents/agentcore/agentcore.json の ROLE_CONFIG_TABLE_NAME と同じテーブルを指定してください。
# Role_Entry 自体は RoleConfigManager（ADMINS 専用メンテナンス画面）から登録します。
# ROLE_CONFIG_TABLE_NAME=RoleConfig-xxxxxxxxxxxxxxxxxxxxxxxxxx-NONE

# ---------------------------------------------------------------------------
# エージェント用環境変数（agents/ 内で使用）
# ---------------------------------------------------------------------------

# 以下は AgentCore Runtime に渡す環境変数です。デプロイ時は
# agents/agentcore/agentcore.json の envVars で設定されるため、ここでの設定は
# ローカル実行（uvicorn / agentcore dev）でエージェント単体を動かす場合のみ必要です。

# AWS MCP Server のエンドポイントとリージョン（未設定時は us-east-1 の既定値）
# AWS_MCP_ENDPOINT=https://aws-mcp.us-east-1.api.aws/mcp
# AWS_MCP_REGION=us-east-1

# Role_Config_Table のテーブル名（エージェントが Role_Entry を Scan する対象）
# 上記のフロントエンド用 ROLE_CONFIG_TABLE_NAME と同じテーブルを指定してください
# ROLE_CONFIG_TABLE_NAME=RoleConfig-xxxxxxxxxxxxxxxxxxxxxxxxxx-NONE

# Role_Config のキャッシュ TTL（秒、既定 30）
# ROLE_CONFIG_CACHE_TTL_SECONDS=30

# OpenTelemetry の警告を抑制してローカル起動する
# LOCAL_DEV=1